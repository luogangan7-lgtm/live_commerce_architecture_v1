  "components": {
    "securitySchemes": {
      "merchantBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque short-lived merchant session; server stores hash only."
      }
    },
    "schemas": {
      "AdsDraftInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ad_binding_id",
          "identity_binding_id",
          "template",
          "source_ref",
          "currency",
          "lifetime_budget_minor",
          "starts_at",
          "ends_at",
          "countries",
          "age_min",
          "age_max"
        ],
        "properties": {
          "ad_binding_id": {
            "type": "string",
            "format": "uuid"
          },
          "identity_binding_id": {
            "type": "string",
            "format": "uuid"
          },
          "template": {
            "enum": [
              "BOOST_POST",
              "PRODUCT_TRAFFIC"
            ]
          },
          "source_ref": {
            "type": "string"
          },
          "currency": {
            "enum": [
              "TWD",
              "USD",
              "HKD"
            ]
          },
          "lifetime_budget_minor": {
            "type": "integer",
            "minimum": 100
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "minItems": 1,
            "maxItems": 10
          },
          "age_min": {
            "type": "integer",
            "minimum": 18,
            "maximum": 65
          },
          "age_max": {
            "type": "integer",
            "minimum": 18,
            "maximum": 65
          }
        }
      },
      "AdsApproveInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "AdsPublishInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publish_attempt"
        ],
        "properties": {
          "publish_attempt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        }
      },
      "AdsBindInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state_id",
          "ad_account_id"
        ],
        "properties": {
          "state_id": {
            "type": "string",
            "format": "uuid"
          },
          "ad_account_id": {
            "type": "string",
            "pattern": "^[0-9]{1,40}$"
          },
          "dataset_id": {
            "type": "string",
            "pattern": "^[0-9]{1,40}$"
          }
        }
      },
      "AdsCapiInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "dataset_binding_id": {
            "type": "string",
            "format": "uuid"
          },
          "test_event_code": {
            "type": "string",
            "pattern": "^[A-Z0-9]{4,20}$"
          }
        }
      }
    }
  }
}
