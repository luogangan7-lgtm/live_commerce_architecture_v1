{
  "openapi": "3.1.0",
  "info": {
    "title": "Live Commerce merchant Meta ads API",
    "version": "meta-ads-v1 FROZEN 2026-09-30",
    "description": "Merchant ads routes (internal/httpapi/ads.go; contracts/meta-ads-v1.md). Source: docs/delivery/units/ads-core.md Frozen HTTP (D1 base path, D5 extra reads, D6 callback JSON); responses are the Draft/settings/report JSON documented there. Tenant and store come from the merchant session. Errors use the shared internal/httperror body {code,message,request_id,retryable,details} (the brief's {error} shape was wrong). Mounted only when cmd/api builds the ads service (COMMERCE_META_ADS_APP_ID) and, per ruling B15, only after 0080 (ads-capi) is merged."
  },
  "paths": {
    "/v1/admin/stores/{store_id}/ads/meta/connect": {
      "post": {
        "operationId": "adsMetaConnect",
        "x-permission": "ads:manage+integration:manage",
        "security": [
          {
            "merchantBearer": []
          }
        ],
        "parameters": [
          {
            "name": "store_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{8,128}$"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "COMMIT acknowledged"
          },
          "401": {
            "description": "unauthorized"
          },
          "402": {
            "description": "billing_restricted (approve/publish)"
          },
          "403": {
            "description": "forbidden"
          },
          "404": {
            "description": "not_found"
          },
          "409": {
            "description": "state_mismatch|revision_changed|over_allowance|attempt_changed|prior_attempt_not_paused|draft_approved|binding_disabled|client_business_changed|conflict"
          },
          "410": {
            "description": "state_expired"
          },
          "422": {
            "description": "invalid_request|not_in_pick_list|budget_below_minimum|not_whole_unit|currency_mismatch|starts_too_soon|source_not_owned|product_not_published"
          },
          "502": {
            "description": "meta_connect_failed (callback only)"
          },
          "503": {
            "description": "retry_later|unavailable"
          }
        }
      }
    },
