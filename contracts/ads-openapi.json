      "get": {
        "operationId": "adsMetaProductFeed",
        "description": "Public Meta catalog feed of one verified storefront host (meta-ads-v1 §7, ads-capi C6; internal/attribution FeedHandler via cmd/api mountFeed on the buyer runtime pool). Called only by the storefront BFF (apps/storefront/app/feeds/meta.csv/route.ts): the store is resolved from X-Commerce-Storefront-Origin, never from a query or store parameter; any query is 422. Columns F17: id,title,description,availability,condition,price,link,image_link,brand.",
        "security": [],
        "parameters": [
          {
            "name": "X-Commerce-Buyer-BFF-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "storefront BFF key; wrong, missing or repeated = 401 before any SQL (constant-time compare)"
          },
          {
            "name": "X-Commerce-Storefront-Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
