                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "持久服务暂不可用，不能假ACK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "amount_minor",
                  "reason",
                  "expected_refundable_minor"
                ],
                "properties": {
                  "amount_minor": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "expected_refundable_minor": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "x-contract": "contracts/stripe-refund-v1.md §7.1 (FROZEN); error codes refundable_changed(409), exceeds_refundable, amount_step, not_refundable, refund_blocked_review, refund_limit (422)"
      }
