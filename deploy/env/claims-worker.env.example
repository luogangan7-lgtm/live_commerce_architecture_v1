# File: deploy/env/claims-worker.env.example -> copy to ${LC_ENV_DIR}/claims-worker.env
# Purpose: KNOBS for cmd/claims-worker (claims intake poller + Meta private-reply dispatcher).
#   DSNs, key files and the enable flag are wiring in deploy/compose.yml (service claims-worker,
#   profile `claims`). It is the only process that sends to Meta users: keep the profile off until
#   the owner approves real sends (docs/runbooks/deploy.md §Meta 私信).
# Runs as/in: env_file of service "claims-worker" (UID 65532, backend + egress networks).
# Reads secrets: none here. Used by: compose.yml; preflight P06/P08. Status: DESIGN.
# Change rules: allowed keys: COMMERCE_META_GRAPH_VERSION, COMMERCE_META_GRAPH_AUTH_HEADER, TZ.
#   COMMERCE_META_GRAPH_BASE_URL is forbidden here (loopback MOCK only, preflight P07): production
#   always talks to https://graph.facebook.com.

# Graph API version, required with NO default (contracts/meta-claims-intake-v1.md probe U5). Use the
# version the owner's LIVE read-only probe (MCI11) confirmed; format vNN.N. CHANGE_ME fails preflight.
COMMERCE_META_GRAPH_VERSION=CHANGE_ME_GRAPH_VERSION
# 0 = access token in the JSON body (probe U6, the default); 1 = Authorization: Bearer.
COMMERCE_META_GRAPH_AUTH_HEADER=0
TZ=UTC
