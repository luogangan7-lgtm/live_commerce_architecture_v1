# File: deploy/env/storefront.env.example -> copy to ${LC_ENV_DIR}/storefront.env (0640 root:root)
# Purpose: per-service KNOBS for the buyer storefront (lc-storefront, `next start`). The buyer
#   flag, API origin, TTL and key files are wiring in deploy/compose.yml (preflight P06).
# Runs as/in: env_file of service "storefront" (UID 1000, edge netns). Reads secrets: none here.
# Used by: compose.yml storefront; preflight P06. Status: DESIGN.
# Change rules: allowed keys: NODE_OPTIONS, TZ. Heap must stay below mem_limit (512m).
NODE_OPTIONS=--max-old-space-size=384
TZ=UTC
