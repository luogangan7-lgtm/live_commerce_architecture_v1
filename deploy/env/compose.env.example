# File: deploy/env/compose.env.example -> copy to /etc/live-commerce/compose.env (0640 root:root)
# Purpose: the ONLY home of cross-service values (deploy-design §11.1). deploy/compose.yml
#   interpolates them into wiring (hosts -> Caddy sites and origins, one TTL -> api "<N>s" and
#   storefront "<N>", shared flags -> api + admin + storefront) so services cannot diverge.
# Runs as/in: read on the host by `docker compose --env-file` (through deploy/scripts/lib.sh
#   lc_compose) and by every deploy/scripts/*.sh via lc_load_env. Never mounted into containers.
# Reads secrets: none. This file must NEVER contain a secret; secrets are files in LC_SECRETS_DIR.
# Used by: compose.yml (all services), preflight.sh (P01, P06, P08, P11-P14), secrets-init.sh
#   (LC_SECRETS_DIR/GID, LC_PG_HOST/SSLMODE for DSNs), deploy.sh, pg-ops.sh, watchdog.sh, smoke.sh.
# Status: DESIGN. Placeholders only (example.com, CHANGE_ME); preflight P01/P11 refuse them
#   in production.
# Change rules: KEY=VALUE lines, no inline comments, no `export`. The shell environment
#   overrides this file (Compose precedence); deploy.sh uses that to pass IMAGE_TAG for
#   upgrade/rollback AND rewrites the IMAGE_TAG line here (atomic rename, owner/mode kept) just
#   before `up -d`, so every other Compose entry point resolves the deployed tag (review P1).

# --- Compose -------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=live-commerce
# db,app = single host. Add payments-sandbox (Phase A) or payments-live (Phase B, owner
# approval), meta (comment intake; needs commerce_meta_apps_json), claims (claims-worker: the ONLY
# process that sends Meta private replies; add it only with owner approval for real sends), ads (ads-worker:
# the ONLY Meta ad-account writer; add it together with api.env COMMERCE_META_ADS_APP_ID, after 0080, ruling B15).
# pg-ops.sh and ops-admin.sh add `ops` by themselves; never list `ops` here.
COMPOSE_PROFILES=db,app,payments-sandbox
# git sha12 of the images built by deploy/scripts/build-images.sh (lc-go/admin/storefront/caddy).
# Maintained by deploy.sh first|upgrade|app-rollback; do not edit by hand (watchdog W10 = drift).
IMAGE_TAG=CHANGE_ME_GIT_SHA12
LC_IMAGE_PREFIX=lc
# production | staging | smoke (smoke relaxes host-name and owner checks; never on a real host).
LC_ENVIRONMENT=production

# --- Edge (published by the edge-netns container) ------------------------------------------
LC_BIND_ADDR=0.0.0.0
LC_HTTP_PORT=80
LC_HTTPS_PORT=443
# Lowercase FQDNs, all distinct, DNS A/AAAA -> this host (preflight P14).
LC_ADMIN_HOST=admin.example.com
LC_STORE_HOST=shop.example.com
LC_API_HOST=api.example.com
LC_HOOKS_HOST=hooks.example.com
# Optional: this host's public IP for preflight P14 when the host sits behind NAT.
LC_PUBLIC_IP=

# --- Host paths ----------------------------------------------------------------------------
LC_ENV_DIR=/etc/live-commerce/env
LC_SECRETS_DIR=/etc/live-commerce/secrets
LC_SECRETS_GID=10500
LC_BACKUP_DIR=/var/backups/live-commerce
LC_STATE_DIR=/var/lib/live-commerce

# --- Database addressing (used by secrets-init.sh to derive DSN secret files) ----------------
# Single host: postgres + disable (traffic never leaves the internal backend network).
# Two hosts: DB private IP + verify-full (preflight P12).
LC_PG_HOST=postgres
LC_PG_SSLMODE=disable

# --- Shared feature flags (0|1) ------------------------------------------------------------
LC_IDENTITY_ENABLED=1
# OIDC issuer URL of the owner's IdP (blocker B2, owner decision O2).
LC_OIDC_ISSUER=https://idp.example.com/

# Merchant email + password login with an emailed one-time code (contracts/merchant-password-auth-v1.md).
# 0 = off (OIDC above stays required). 1 = on: OIDC becomes optional (leave LC_OIDC_ISSUER empty for
# password-only), and the SMTP settings below plus secrets commerce_auth_pepper (generated) and
# commerce_smtp_password (owner-supplied SMTP authorization code of a DEDICATED sending mailbox) are required.
# The admin host must stay DNS-only (no Cloudflare proxy) while this is 1: per-IP limits read the edge's
# X-Forwarded-For (preflight rule "admin host resolves only to this host").
LC_PASSWORD_LOGIN_ENABLED=0
# Implicit-TLS SMTP on 465. First configuration: smtp.qq.com with the mailbox's full address as username;
# upgrade path smtp.exmail.qq.com. LC_MAIL_FROM must carry exactly the LC_SMTP_USERNAME address.
LC_SMTP_HOST=smtp.qq.com
LC_SMTP_USERNAME=CHANGE_ME_SENDER@qq.com
LC_MAIL_FROM=xgdwm <CHANGE_ME_SENDER@qq.com>
# Deployment-wide mail budget per UTC+8 day (20-100000). The mailbox's real daily cap is UNKNOWN until measured.
LC_MAIL_DAILY_CAP=200
# hibp = refuse breached passwords via the k-anonymity range API (fails open); off is refused outside loopback tests.
LC_BREACH_CHECK=hibp
LC_ONBOARDING_ENABLED=1
LC_ONBOARDING_CURRENCIES=TWD
LC_BUYER_ENABLED=1
# 60..2592000 seconds; api receives "<N>s", storefront "<N>".
LC_BUYER_SESSION_TTL_SECONDS=2592000
# Stripe (stripe-psp-v1, stripe-live-enable-v1 LD6): LC_STRIPE_ENABLED=1 = api webhook route and the payment
# worker's Stripe/refund dispatch for the deployed profile. Needs COMMERCE_PAYMENT_PROFILE=SANDBOX (api.env) and the
# payments-sandbox profile, or LIVE + payments-live + the LIVE pair below (preflight P06 checks both directions).
LC_STRIPE_ENABLED=1
# Platform kill switch: buyer Stripe checkout only. Unset = follows LC_STRIPE_ENABLED; 0 + deploy.sh removes Stripe
# from the hosted checkout while webhook and worker keep reconciling (docs/runbooks/stripe-live.md §3).
#LC_STRIPE_CHECKOUT_ENABLED=1
# LIVE pair (both or neither): set ONLY for a LIVE deployment, after the owner's written approval; the ref points to
# that message (LQ8: owner-chat:<YYYY-MM-DD>:stripe-live:<store-slug>). Keys never go here (ops-admin.sh <NAME>_FILE).
#LC_STRIPE_LIVE_ENABLED=1
#LC_STRIPE_LIVE_APPROVAL_REF=owner-chat:YYYY-MM-DD:stripe-live:store-slug
# Platform-fee billing (customers-billing-v1 T17): unset = off; 1 = api serves GET/POST billing and the
# platform webhook POST /v1/platform/stripe/webhook. Needs the owner-supplied secret files
# commerce_platform_stripe_secret_key (sk_test_/rk_test_ only, SANDBOX) and
# commerce_platform_stripe_webhook_secret, plus the plan price ids below (not secrets).
# LC_BILLING_ENABLED=1
# LC_BILLING_PRICE_IDS=price_REPLACE_ME
# ECPay logistics switch (taiwan-cvs-logistics-v1 §12): 1 = api ECPay map/connect/status routes + the claims-worker
# ecpay.cvs_create route. Needs COMMERCE_PAYMENT_PROFILE=SANDBOX (api.env; LIVE ECPay is not enabled in this release),
# the claims profile (the create route runs in claims-worker) and the owner-supplied ecpay_logistics_keyring secret
# (preflight P06/P09). 0 (pilot default, X11): ECPay routes answer 404; buyer-entered stores and pay-at-pickup keep working.
LC_CVS_ECPAY_ENABLED=0

# --- Readiness gates -----------------------------------------------------------------------
# 0 = live.media_plan_ready() is informational (LiveKit media not deployable, COMMERCE_STUDIO_MEDIA_ENABLED=0; the gate is also
# false on every LOGICALLY restored DB, see deploy/postgres/ops/verify.sql). Set 1 only once
# Studio/media are deployable and the gate is restore-stable (REQUIRES_INTEGRATOR).
LC_REQUIRE_MEDIA_GATE=0
# claims-retention-purge-v1 §10(5): with the claims profile on, deploy.sh post-checks run
# `retention-admin status` on the claims-worker's retention-job login and require a purge run in the last
# 26 h and (1, default) enforced=1. 0 only under waiver W1 (owner's own pilot store, before the
# owner-approved `policy-set --enforced=true`; docs/runbooks/claims-data-deletion.md); never with a second merchant.
LC_REQUIRE_RETENTION_ENFORCED=1

# --- Alerts (optional) ---------------------------------------------------------------------
# watchdog.sh POSTs only failing check ids (never values) here when set.
LC_ALERT_WEBHOOK_URL=
