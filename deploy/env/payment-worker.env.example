# File: deploy/env/payment-worker.env.example -> copy to ${LC_ENV_DIR}/payment-worker.env
# Purpose: KNOBS shared by payment-worker-sandbox and payment-worker-live (cmd/payment-worker).
#   Profile, DSN and account keyring are wiring in deploy/compose.yml.
# Runs as/in: env_file of both payment worker services (UID 65532, backend + egress networks).
# Reads secrets: none here. Used by: compose.yml; preflight P06/P08. Status: DESIGN.
# Change rules: allowed keys: COMMERCE_PAYMENT_WORKER_CONCURRENCY (canonical decimal 1-16), TZ.
COMMERCE_PAYMENT_WORKER_CONCURRENCY=4
TZ=UTC
