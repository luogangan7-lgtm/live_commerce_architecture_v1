# File: deploy/env/caddy.env.example -> copy to ${LC_ENV_DIR}/caddy.env (0640 root:root)
# Purpose: ACME settings for the Caddy edge (deploy/caddy/Caddyfile global options).
# Runs as/in: env_file of service "caddy" (lc-caddy, UID 10001, edge netns).
# Reads secrets: none (the ACME account key is generated by Caddy into the caddy-data volume).
# Used by: compose.yml caddy; preflight P11 (production refuses placeholders/staging CA).
# Status: DESIGN. Change rules: allowed keys: ACME_EMAIL, LC_ACME_CA, TZ.

# ACME account contact (certificate expiry notices). Must be a real mailbox in production.
ACME_EMAIL=ops@example.com
# Leave unset (commented) for Let's Encrypt production. Never set it to an empty value: Caddy
# then fails to parse the Caddyfile (preflight P11 catches this). For rehearsals uncomment:
# LC_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
TZ=UTC
