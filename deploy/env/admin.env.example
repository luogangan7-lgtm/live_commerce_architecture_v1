# File: deploy/env/admin.env.example -> copy to ${LC_ENV_DIR}/admin.env (0640 root:root)
# Purpose: per-service KNOBS for the merchant admin (lc-admin, Next standalone). Everything
#   else (HOSTNAME/PORT listener, origins, identity/onboarding flags, BFF key file) is wiring
#   in deploy/compose.yml and must not be redefined here (preflight P06).
# Runs as/in: env_file of service "admin" (UID 1000, edge netns). Reads secrets: none here.
# Used by: compose.yml admin; preflight P06. Status: DESIGN.
# Change rules: allowed keys: NODE_OPTIONS, TZ. Heap must stay below mem_limit (384m).
NODE_OPTIONS=--max-old-space-size=256
TZ=UTC
