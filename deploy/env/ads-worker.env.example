# File: deploy/env/ads-worker.env.example -> copy to ${LC_ENV_DIR}/ads-worker.env
# Purpose: KNOBS for cmd/ads-worker (meta-ads-v1 §6: the only Meta ad-account writer and the only
#   process holding the HPKE private ring that opens a merchant's BISU token). DSN and the private
#   key file are wiring in deploy/compose.yml (service ads-worker, profile `ads`).
# Runs as/in: env_file of service "ads-worker" (UID 65532, backend + egress networks).
# Reads secrets: none here. Used by: compose.yml; preflight P06/P08. Status: DESIGN.
# Change rules: allowed keys: COMMERCE_META_ADS_GRAPH_VERSION, COMMERCE_META_ADS_PARTNER_AGENT, TZ.
#   There is no Graph base-URL knob: production always talks to https://graph.facebook.com.

# Graph API version (A-9); must equal api.env COMMERCE_META_ADS_GRAPH_VERSION (preflight P08).
COMMERCE_META_ADS_GRAPH_VERSION=v26.0
# CAPI `partner_agent` constant (F7), [A-Za-z0-9_.-]{1,50}; required even before CAPI is enabled.
COMMERCE_META_ADS_PARTNER_AGENT=CHANGE_ME_PARTNER_AGENT
TZ=UTC
