+
+	// Validation -> ErrInvalid (§4.3 step 1), before any write.
+	n = eventCount()
+	base := h.ingestIn(s, lcActor(), "valid", "A1", h.dbNow(t))
+	mut := func(fn func(*claims.IngestInput)) claims.IngestInput { x := base; x.SourceEventID = randomUUID(); fn(&x); return x }
