+	lcIs(t, lcErr(h.ingest(mut(func(x *claims.IngestInput) { x.ActorLabel = "" }))), command.ErrInvalid, "new bundle without ActorLabel")
+	rr, err := h.f.runtime.BeginTx(h.ctx, pgx.TxOptions{IsoLevel: pgx.RepeatableRead})
+	if err != nil {
