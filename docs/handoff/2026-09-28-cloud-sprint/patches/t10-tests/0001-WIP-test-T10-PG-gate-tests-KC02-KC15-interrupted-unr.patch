+		in claims.IngestInput
+		p  grammar.Result
+	}{
+		"text with parsed": {mut(func(x *claims.IngestInput) {}), parsed},
+		"version":          {mut(func(x *claims.IngestInput) { x.Text = "" }), grammar.Result{Version: "kw-v2", Kind: grammar.Match, Keyword: "A1", Quantity: 1}},
