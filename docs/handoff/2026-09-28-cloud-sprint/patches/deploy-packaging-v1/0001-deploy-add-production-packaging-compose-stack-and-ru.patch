+  pw_lc_api_buyer: { file: "${LC_SECRETS_DIR:?set LC_SECRETS_DIR}/pw_lc_api_buyer" }
+  pw_lc_api_checkout: { file: "${LC_SECRETS_DIR:?set LC_SECRETS_DIR}/pw_lc_api_checkout" }
+  pw_lc_api_hosted: { file: "${LC_SECRETS_DIR:?set LC_SECRETS_DIR}/pw_lc_api_hosted" }
+  pw_lc_api_meta_ingress: { file: "${LC_SECRETS_DIR:?set LC_SECRETS_DIR}/pw_lc_api_meta_ingress" }
+  pw_lc_expiry_worker: { file: "${LC_SECRETS_DIR:?set LC_SECRETS_DIR}/pw_lc_expiry_worker" }
+  pw_lc_payment_sandbox: { file: "${LC_SECRETS_DIR:?set LC_SECRETS_DIR}/pw_lc_payment_sandbox" }
+  pw_lc_payment_live: { file: "${LC_SECRETS_DIR:?set LC_SECRETS_DIR}/pw_lc_payment_live" }
+  pw_lc_meta_worker: { file: "${LC_SECRETS_DIR:?set LC_SECRETS_DIR}/pw_lc_meta_worker" }
+  pw_lc_meta_consumer: { file: "${LC_SECRETS_DIR:?set LC_SECRETS_DIR}/pw_lc_meta_consumer" }
+  dsn_lc_api_runtime: { file: "${LC_SECRETS_DIR:?set LC_SECRETS_DIR}/dsn_lc_api_runtime" }
+  dsn_lc_api_identity: { file: "${LC_SECRETS_DIR:?set LC_SECRETS_DIR}/dsn_lc_api_identity" }
+  dsn_lc_api_buyer_issuer: { file: "${LC_SECRETS_DIR:?set LC_SECRETS_DIR}/dsn_lc_api_buyer_issuer" }
