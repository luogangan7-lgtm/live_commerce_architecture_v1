+  if [[ "$v" != [Nn][Oo]_* && "${!v}" =~ ^[A-Za-z0-9+.-]+://([^/@]*@)?(\[::1\]|localhost|127\.[0-9.]+)(:|/|$) ]]; then
+    loopback_proxy+=" $v"
