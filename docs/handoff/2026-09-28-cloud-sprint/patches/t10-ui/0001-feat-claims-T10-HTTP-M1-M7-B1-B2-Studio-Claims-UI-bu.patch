+/* Studio › Claims surface-local layout (T10b). Reuses the Studio workbench language from
+   globals.css (joined white surface, 1px cool rules, 5px controls, teal primary, blue
+   focus, words for every state) and DESIGN.md tokens; nothing here changes shared tokens,
+   the ledger breakpoints or other surfaces. Order on narrow screens: window rail →
+   offers → manual entry → buyers, never a shrunken multi-column view. */
+.claims-page { padding-bottom: 32px; }
+.claims-breadcrumb { display: flex; align-items: center; gap: 8px; margin-bottom: 2px; color: var(--muted); font-size: 13px; }
+.claims-crumb { min-height: 0; padding: 0; border: 0; background: none; color: var(--focus); font-weight: 400; text-decoration: underline; text-underline-offset: 3px; }
+.claims-crumb:hover:not(:disabled) { background: none; }
+.claims-mock { margin: 0 4px 16px; padding: 13px 16px; border: 1px solid #bfdbf4; border-radius: 6px; background: #eef6ff; color: #174b7c; }
+.claims-mock strong { display: block; }
+.claims-mock p { margin-top: 3px; }
+.claims-status { margin: 8px 4px; color: var(--muted); }
+.claims-surface { display: grid; grid-template-columns: 340px minmax(0, 1fr); background: #fff; border: 1px solid var(--line); border-radius: 7px; overflow: hidden; }
+.claims-rail { min-width: 0; padding: 24px 24px 28px; border-right: 1px solid var(--line); }
+.claims-work { min-width: 0; }
+.claims-section { min-width: 0; padding: 24px 26px 28px; }
+.claims-work > .claims-section + .claims-section { border-top: 1px solid var(--line); }
+.claims-section h2, .claims-rail h2 { font-size: 19px; line-height: 1.4; }
+.claims-rail h3 { margin: 0 0 12px; font-size: 16px; line-height: 1.4; }
+.claims-window-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+.claims-badge { display: inline-block; padding: 3px 12px; border-radius: 20px; font-size: 12px; line-height: 1.3; white-space: nowrap; }
+.claims-badge.open { background: #d9f2e9; color: #126953; }
+.claims-badge.closed { background: #edf1f5; color: #3e4f63; }
+.claims-facts { display: grid; gap: 9px; margin: 16px 0 0; }
+.claims-facts > div { display: flex; justify-content: space-between; gap: 14px; }
+.claims-facts dt { color: var(--muted); }
+.claims-facts dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }
+.claims-field { display: grid; gap: 7px; min-width: 0; }
+.claims-field > label { font-weight: 600; }
+.claims-field input, .claims-field select { width: 100%; min-width: 0; }
+.claims-rail > .claims-field { margin-top: 20px; }
+.claims-muted { color: var(--muted); }
+.claims-rail > .claims-muted { margin-top: 8px; font-size: 13px; }
+.claims-window-action { width: 100%; min-height: 45px; margin-top: 18px; }
+.claims-stats, .claims-prompt { margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--line); }
+.claims-stats .claims-facts { margin-top: 0; }
+.claims-hint { margin-top: 12px; padding: 10px 12px; border: 1px solid #f0d8b0; border-radius: 5px; background: #fff8ec; color: #86551a; }
+.claims-prompt-controls { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px; }
+.claims-prompt-text { margin: 12px 0; padding: 12px 14px; border: 1px solid var(--line); border-radius: 5px; background: #f4f7fa; overflow-wrap: anywhere; }
+.claims-table-scroll { margin-top: 14px; overflow-x: auto; border: 1px solid var(--line); border-radius: 6px; scrollbar-color: #71869e #edf2f7; scrollbar-width: thin; }
+table.claims-table { table-layout: auto; font-variant-numeric: tabular-nums; }
+.claims-table > thead > tr > th { width: auto; height: 38px; white-space: nowrap; }
+.claims-table > tbody > tr > th, .claims-table > tbody > tr > td { height: auto; padding: 10px 13px; vertical-align: top; }
+.claims-table small { display: block; margin-top: 2px; color: var(--muted); font-size: 12px; }
+.claims-keyword, .claims-ref { font-weight: 700; letter-spacing: .3px; }
+.claims-product { overflow-wrap: anywhere; }
+.claims-table input { width: 84px; }
+.claims-row-actions { white-space: nowrap; }
+.claims-row-actions button + button { margin-left: 8px; }
+.claims-lines { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }
+.claims-form { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1fr) 110px auto; align-items: end; gap: 12px; margin-top: 18px; }
+/* The label field appears only for a new buyer, so this row wraps instead of fixed columns. */
+.claims-form.claims-manual-form { display: flex; flex-wrap: wrap; }
+.claims-manual-form > .claims-field { flex: 1 1 200px; }
+.claims-manual-form > .primary { flex: none; }
+.claims-form > .primary { min-height: 39px; white-space: nowrap; }
+.claims-form-hint, .claims-form > [role="status"] { grid-column: 1 / -1; font-size: 13px; }
+.claims-result { margin-top: 14px; padding: 11px 13px; border-radius: 5px; }
+.claims-result.accepted { background: #d9f2e9; color: #126953; }
+.claims-result.rejected { background: #fff5f5; color: #8e2732; }
+.claims-alert { margin-top: 14px; padding: 12px 13px; border: 1px solid #ebc7cb; border-radius: 5px; background: #fff5f5; color: #8e2732; }
+.claims-alert button { margin-top: 10px; }
+.claims-bundles { margin-top: 18px; background: #fff; border: 1px solid var(--line); border-radius: 7px; }
+.claims-more { margin-top: 14px; }
+.claims-dialog { width: min(560px, calc(100vw - 32px)); padding: 0; border: 1px solid var(--line); border-radius: 7px; color: var(--ink); }
+.claims-dialog::backdrop { background: rgba(20, 41, 66, .45); }
+.claims-dialog-body { display: grid; gap: 14px; padding: 22px; }
+.claims-dialog-body h2 { font-size: 18px; line-height: 1.4; }
+.claims-mock-inline { color: #174b7c; font-size: 13px; }
+.claims-alert-text { color: #8e2732; }
+.claims-link-value { display: block; padding: 11px 12px; border: 1px solid var(--line); border-radius: 5px; background: #f4f7fa; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 13px; overflow-wrap: anywhere; }
+.claims-dialog-actions { display: flex; flex-wrap: wrap; gap: 8px; }
+.claims-dialog-close { justify-self: start; min-height: 42px; }
+@media (max-width: 1160px) {
+  .claims-form, .claims-manual-form { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
+  .claims-form > .primary { grid-column: 1 / -1; justify-self: start; }
+}
+@media (max-width: 980px) {
+  .claims-surface { display: block; }
+  .claims-rail { border-right: 0; border-bottom: 1px solid var(--line); }
+}
+@media (max-width: 680px) {
+  .claims-mock { margin: 0 0 14px; }
+  .claims-rail, .claims-section { padding: 20px 16px 24px; }
+  .claims-form, .claims-manual-form, .claims-prompt-controls { grid-template-columns: minmax(0, 1fr); }
+  .claims-form > .primary { width: 100%; }
+  .claims-table-scroll { border: 0; overflow-x: visible; }
+  .claims-table, .claims-table > tbody, .claims-table > tbody > tr { display: block; width: 100%; }
+  .claims-table > thead { display: none; }
+  .claims-table > tbody > tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
+  .claims-table > tbody > tr > th, .claims-table > tbody > tr > td { padding: 0; border: 0; }
+  .claims-table > tbody > tr > .claims-row-actions { grid-column: 1 / -1; white-space: normal; display: flex; flex-wrap: wrap; gap: 8px; }
+  .claims-row-actions button + button { margin-left: 0; }
+}
diff --git a/apps/admin/lib/claims-client.ts b/apps/admin/lib/claims-client.ts
new file mode 100644
index 0000000..a81f869
--- /dev/null
+++ b/apps/admin/lib/claims-client.ts
@@ -0,0 +1,91 @@
+// Owns the Studio › Claims browser requests: M1–M7 through the same private Studio
+// read/write boundary (same-origin BFF, CSRF header, session-boundary check before and
+// after every write, private no-store JSON only), plus the existing catalog reads the
+// offer form and link builder need (products, SKUs, purchase-entry origin).
+// Non-goals: no retries or key generation (the component owns one key per submit and
+// reuses it only for an explicit "retry same request"), no storage of any response, and
+// no token persistence: an issued link token is returned to the caller's memory only.
+// Depends on: studio-client.ts (read, write, StudioError), claims-model.ts (parsers).
+
+import { read, StudioError, write } from "./studio-client";
+import {
+  catalogProduct, catalogSKU, parseBoard, parseBundlePage, parseCatalogPage, parseClaimLink,
+  parseManualResult, parseOffer, parsePurchaseEntry, parseWindow,
+  type CatalogProduct, type CatalogSKU, type MatchMode,
+} from "./claims-model";
+
+const base = (store: string, session: string) => `/api/stores/${store}/live-sessions/${session}/claims`;
+// Any parse failure after a write is an unknown result: it may have committed.
+async function parsed<T>(work: () => Promise<unknown>, parse: (value: unknown) => T, uncertain: boolean): Promise<T> {
+  try { return parse(await work()); }
+  catch (error) { throw error instanceof StudioError ? error : new StudioError(uncertain ? "uncertain" : "unavailable"); }
+}
+
+// Every call below goes through the admin BFF (same-origin, signed session cookie); Go
+// re-checks live:read (reads) or live:manage (writes) inside its own transaction. The only
+// caller is components/StudioClaims.tsx.
+
+/** M1: window, offers and per-reason stats of the current round (live:read). */
+export const readClaimsBoard = (store: string, session: string, signal: AbortSignal) =>
+  parsed(() => read(base(store, session), signal), (value) => parseBoard(value, session), false);
+/** M6: bundles newest first, 100 per page; cursor "" is the first page (live:read). */
+export const readClaimBundles = (store: string, session: string, cursor: string, signal: AbortSignal) =>
+  parsed(() => read(`${base(store, session)}/bundles?limit=100${cursor ? `&cursor=${cursor}` : ""}`, signal), parseBundlePage, false);
+
+/** M2: open, close or re-mode the window with a version CAS (live:manage). */
+export const setClaimWindow = (store: string, session: string, body: { expected_version: number; state: "OPEN" | "CLOSED"; match_mode: MatchMode }, key: string, boundary: string) =>
+  parsed(() => write(`${base(store, session)}/window`, "POST", body, key, boundary), (value) => parseWindow(value, session), true);
+/** M3: bind a keyword to a SKU in this scene (live:manage). */
+export const createClaimOffer = (store: string, session: string, body: { keyword: string; sku_id: string; max_quantity_per_claim: number }, key: string, boundary: string) =>
+  parsed(() => write(`${base(store, session)}/offers`, "POST", body, key, boundary), (value) => parseOffer(value, session), true);
+/** M4: change an offer's limit or active flag with a version CAS (live:manage). */
+export const updateClaimOffer = (store: string, session: string, offer: string, body: { expected_version: number; max_quantity_per_claim: number; active: boolean }, key: string, boundary: string) =>
+  parsed(() => write(`${base(store, session)}/offers/${offer}`, "PATCH", body, key, boundary), (value) => parseOffer(value, session), true);
+/** M5: record one operator-attested comment; REJECTED is a result, not an error (live:manage). */
+export const recordManualClaim = (store: string, session: string, body: { text: string } & ({ bundle_id: string } | { actor_label: string }), key: string, boundary: string) =>
+  parsed(() => write(`${base(store, session)}/manual`, "POST", body, key, boundary), parseManualResult, true);
+/**
+ * M7: issue, replace or release+replace a bundle link with a generation CAS (live:manage).
+ * The returned token (first execution only) must stay in component memory and be dropped
+ * when the one-time dialog closes; a replay returns token null.
+ */
+export const issueClaimLink = (store: string, session: string, bundle: string, body: { expected_generation: number; release_binding: boolean }, key: string, boundary: string) =>
+  parsed(() => write(`${base(store, session)}/bundles/${bundle}/link`, "POST", body, key, boundary), parseClaimLink, true);
+
+// Catalog routes answer "no-store" (not "private, no-store"), so they use this plain read.
+async function catalogRead(path: string, signal: AbortSignal): Promise<unknown> {
+  let response: Response;
+  try { response = await fetch(path, { method: "GET", cache: "no-store", credentials: "same-origin", signal }); }
+  catch { throw new StudioError("unavailable"); }
+  if (!response.ok) throw new StudioError(response.status === 401 ? "signed-out" : response.status === 403 ? "forbidden" : response.status === 404 ? "not-found" : "unavailable");
+  try { return await response.json(); } catch { throw new StudioError("unavailable"); }
+}
+
+/** Active products of the store (first 100), for the offer form's product picker. */
+export const readClaimProducts = (store: string, signal: AbortSignal): Promise<CatalogProduct[]> =>
+  parsed(() => catalogRead(`/api/stores/${store}/products?limit=100`, signal),
+    (value) => parseCatalogPage(value, catalogProduct).items.filter((item) => item.status === "active"), false);
+/** Active SKUs of one product (first 100), for the offer form's SKU picker. */
+export const readClaimSKUs = (store: string, product: string, signal: AbortSignal): Promise<CatalogSKU[]> =>
+  parsed(() => catalogRead(`/api/stores/${store}/products/${product}/skus?limit=100`, signal),
+    (value) => parseCatalogPage(value, catalogSKU).items.filter((item) => item.status === "active" && item.product_id === product), false);
+
+/**
+ * The published storefront origin, read through the existing merchant purchase-entry
+ * projection (the only merchant route that resolves it). The origin is store-wide, so the
+ * first configured product decides; a store-level state (unpublished, no domain) or no
+ * configured product within the first ten active products returns null.
+ */
+export async function readStorefrontOrigin(store: string, products: CatalogProduct[], signal: AbortSignal): Promise<string | null> {
+  for (const product of products.slice(0, 10)) {
+    const entry = await parsed(() => catalogRead(`/api/stores/${store}/products/${product.id}/purchase-entry?locale=en`, signal),
+      (value) => parsePurchaseEntry(value, product.id, "en"), false);
+    if (entry.state === "configured") {
+      const url = new URL(entry.url);
+      if (url.protocol !== "https:" || url.pathname !== `/en/products/${product.id}`) throw new StudioError("unavailable");
+      return url.origin;
+    }
+    if (entry.state === "storefront_unavailable" || entry.state === "domain_selection_required") return null;
+  }
+  return null;
+}
